{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "IRONCLAD_API_KEY": "<insert ironclad api key>"
            }
        },
        {
            "name": "Python Debugger: list assets",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["list", "--source", "all"],
            "env": {
                "IRONCLAD_API_KEY": "<insert ironclad api key>"
            }
        },
        {
            "name": "Python Debugger: search assets",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["search", "--query", "Windows 11", "--limit", "550"],
            "env": {
                "IRONCLAD_API_KEY": "<insert ironclad api key>"
            }
        },
        {
            "name": "Python Debugger: create tickets from vulns",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["ticket", "--source", "all", "--limit", "3"],
            "env": {
                "IRONCLAD_API_KEY": "<insert ironclad api key>",
                "TRELLO_BOARD_ID": "<insert board ID>",
                "TRELLO_LIST_ID": "<insert list ID>",
                "TRELLO_TOKEN": "<insert trello token>",
                "TRELLO_KEY": "<insert trello API Key>"
            }
        }
    ]
}